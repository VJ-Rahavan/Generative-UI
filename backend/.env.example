# --- LLM (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=8192
# low | medium | high (only applied to reasoning models such as gpt-oss)
LLM_REASONING_EFFORT=medium

# --- LangSmith tracing (optional) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=fitgen

# --- Agent ---
AGENT_MAX_STEPS=8
AGENT_MAX_UI_REPAIRS=2
HISTORY_MAX_MESSAGES=40

# --- Database ---
# Postgres: postgresql+asyncpg://user:pass@localhost:5432/fitgen  (uv sync --extra postgres)
DATABASE_URL=sqlite+aiosqlite:///./fitgen.db
SEED_DEMO_DATA=true

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5180"]
